{
  "disable_existing_loggers": false,
  "formatters": {
    "simple": {
      "datefmt": "%Y-%m-%dT%H:%M:%S%z",
      "format": "-- {asctime} {levelname}:{module}:{lineno} {message}",
      "style": "{"
    }
  },
  "handlers": {
    "file": {
      "backupCount": 2,
      "class": "logging.handlers.RotatingFileHandler",
      "encoding": "utf-8",
      "filename": "/tmp/miranda_log",
      "formatter": "simple",
      "maxBytes": 1000000,
      "mode": "a"
    },
    "stdout": {
      "class": "logging.StreamHandler",
      "formatter": "simple",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "miranda": {
      "handlers": [
        "file",
        "stdout"
      ],
      "level": "NOTSET"
    },
    "root": {
      "level": "NOTSET"
    }
  },
  "version": 1
}
